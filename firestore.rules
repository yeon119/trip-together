rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /rooms/{roomId} {
      // A high-entropy invitation link grants read access; room enumeration is denied.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title','dates','tripDays','expected','owner','finalStart','createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.dates is list
        && request.resource.data.dates.size() >= 1 && request.resource.data.dates.size() <= 120
        && request.resource.data.tripDays is int
        && request.resource.data.tripDays >= 1 && request.resource.data.tripDays <= 14
        && request.resource.data.tripDays <= request.resource.data.dates.size()
        && request.resource.data.expected is int
        && request.resource.data.expected >= 2 && request.resource.data.expected <= 30
        && request.resource.data.finalStart == ''
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finalStart'])
        && request.resource.data.finalStart is string
        && (request.resource.data.finalStart == '' || (
          request.resource.data.finalStart in resource.data.dates
          && request.resource.data.finalStart <= resource.data.dates[resource.data.dates.size() - resource.data.tripDays]));
      allow delete: if false;
      match /members/{uid} {
        function room() { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
        allow read: if signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId));
        allow create, update: if signedIn() && request.auth.uid == uid
          && room().finalStart == ''
          && request.resource.data.keys().hasOnly(['name','dates','updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.dates is list
          && request.resource.data.dates.size() <= 120
          && request.resource.data.dates.toSet().size() == request.resource.data.dates.size()
          && request.resource.data.dates.hasOnly(room().dates)
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid && room().finalStart == '';
      }
    }
  }
}
